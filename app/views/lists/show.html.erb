<div class="container my-4">
  <%= link_to "← All lists", lists_path %>
  <h1 class="my-3"><%= @list.name %></h1>
  <%= simple_form_for [@list, @bookmark] do |f| %>
    <%= f.association :movie,
          collection: Movie.order(:title),
          label_method: :title,
          value_method: :id,
          prompt: "Choose a movie" %>
    <%= f.input :comment %>
    <%= f.button :submit, "Add to list", class: "btn btn-primary" %>
  <% end %>

  <% if @list.bookmarks.empty? %>
    <p class="text-muted">Nothing here yet. Add your first movie!</p>
  <% else %>
    <div class="row">
      <% @list.bookmarks.includes(:movie).each do |bookmark| %>
        <div class="col-6 col-md-4 col-lg-3 mb-3">
          <div class="card h-100">
            <% if bookmark.movie.poster_url.present? %>
              <%= image_tag bookmark.movie.poster_url, class: "card-img-top", alt: bookmark.movie.title %>
            <% end %>
            <div class="card-body">
              <h5 class="card-title"><%= bookmark.movie.title %></h5>
              <h6 class="card-subtitle mb-2 text-muted">Rating: <%= bookmark.movie.rating %></h6>
              <p class="card-text"><%= bookmark.movie.overview %></p>
              <p class="fst-italic">"<%= bookmark.comment %>"</p>
              <%= link_to "Remove", bookmark_path(bookmark),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :delete, turbo_confirm: "Remove this movie from the list?" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <h2 class="mt-5 mb-3">Reviews</h2>

  <%= simple_form_for [@list, @review] do |f| %>
    <%= f.input :content, as: :text, label: "Your review" %>
    <%= f.input :rating, collection: 0..5, prompt: "Choose a rating" %>
    <%= f.button :submit, "Post review", class: "btn btn-primary" %>
  <% end %>

  <div class="mt-4">
    <% if @list.reviews.empty? %>
      <p class="text-muted">No reviews yet. Be the first!</p>
    <% else %>
      <% @list.reviews.order(created_at: :desc).each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <div class="text-warning">
              <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
            </div>
            <p class="card-text my-2"><%= review.content %></p>
            <small class="text-muted"><%= time_ago_in_words(review.created_at) %> ago</small>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
